{
  "easycom": {
    "autoscan": true,
    // 注意一定要放在custom里，否则无效，https://ask.dcloud.net.cn/question/131175
    "custom": {
      "^u--(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^up-(.*)": "uview-plus/components/u-$1/u-$1.vue",
      "^u-([^-].*)": "uview-plus/components/u-$1/u-$1.vue"
    }
  },
  "pages": [
    //pages数组中第一项表示应用启动页，参考：https://uniapp.dcloud.io/collocation/pages
    {
      "path": "pages/index/index",
      "style": {
        //  "navigationBarTitleText": "",
        "navigationStyle": "custom", // 隐藏系统导航栏
        "enablePullDownRefresh": true,
        "app-plus": {
          "bounce": "none", //关闭窗口回弹效果,禁用拉伸
          "pullToRefresh": {
            //下拉刷新样式
            "color": "#00A8FF",
            "style": "circle",
            "offset": "70px",
            "support": true
          }
        }
      }
    },
    {
      "path": "pages/books/index",
      "style": {
        // "navigationBarTitleText": "",
        "enablePullDownRefresh": true,
        "app-plus": {
          "bounce": "none", //关闭窗口回弹效果,禁用拉伸
          "pullToRefresh": {
            //下拉刷新样式
            "color": "#00A8FF",
            "style": "circle",
            "offset": "56px",
            "support": true
          }
        }
      }
    },
    {
      "path": "pages/user/index",
      "style": {
        // "navigationBarTitleText": "",
        "enablePullDownRefresh": false
      }
    },
    {
      "path": "pages/search/index",
      "style": {
        "navigationStyle": "custom",
        "navigationBarTitleText": "",
        "enablePullDownRefresh": false
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "XX阅读",
    "navigationBarBackgroundColor": "#ffffff",
    "backgroundColor": "#ffffff",
    "app-plus": {
      "bounce": "none" //关闭窗口回弹效果,禁用拉伸
    }
    //不使用原生导航栏
    // "navigationStyle": "custom"
  },

  "uniIdRouter": {},
  "tabBar": {
    "color": "#bfbfbf",
    "selectedColor": "#2c2c2c",
    "backgroundColor": "#ffffff",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "书架",
        "iconPath": "static/images/tabBar/index0.png",
        "selectedIconPath": "static/images/tabBar/index1.png"
      },
      {
        "pagePath": "pages/books/index",
        "text": "书城",
        "iconPath": "static/images/tabBar/books0.png",
        "selectedIconPath": "static/images/tabBar/books1.png"
      },
      {
        "pagePath": "pages/user/index",
        "text": "我的",
        "iconPath": "static/images/tabBar/user0.png",
        "selectedIconPath": "static/images/tabBar/user1.png"
      }
    ]
  }
}
